@model IEnumerable<AkarangaBank.Web.Models.Compte>
@{
    ViewData["Title"] = "Mes comptes";
    var client = (AkarangaBank.Web.Models.Client)ViewBag.Client;
}

<h2>💳 Bonjour @client.Nom @client.Prenom</h2>
<p class="text-muted">Client @client.NumeroClient</p>

@if (!Model.Any())
{
    <p class="text-muted">Vous n'avez aucun compte pour le moment.</p>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title">@c.NumeroCompte</h5>
                        <p class="text-muted mb-1">@c.TypeCompte.Libelle</p>
                        <h3 class="text-success">@c.Solde.ToString("N0") @c.Devise</h3>
                        <a asp-action="Releve" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Voir le relevé</a>
                    </div>
                </div>
            </div>
        }
    </div>
}