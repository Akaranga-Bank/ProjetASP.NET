@{
    ViewData["Title"] = "Mon espace";
    var user = (AkarangaBank.Web.Models.ApplicationUser)ViewBag.User;
    var client = ViewBag.Client as AkarangaBank.Web.Models.Client;
    var mesComptes = ViewBag.MesComptes as List<AkarangaBank.Web.Models.Compte> ?? new List<AkarangaBank.Web.Models.Compte>();
}

<h2>Bienvenue @user.NomComplet 👋</h2>
<p class="text-muted">Votre espace bancaire personnel</p>

@if (client == null)
{
    <div class="alert alert-warning">
        Aucun client n'est associé à votre compte. Contactez votre agence.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Numéro client</h6>
                    <h5>@client.NumeroClient</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Mes comptes</h6>
                    <h3 class="text-primary">@mesComptes.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Mon solde total</h6>
                    <h3 class="text-success">@(((decimal)ViewBag.MonSolde).ToString("N0")) BIF</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <a asp-controller="MesComptes" asp-action="Index" class="btn btn-primary">💳 Mes comptes</a>
        <a asp-controller="MesComptes" asp-action="Virement" class="btn btn-success">🔁 Faire un virement</a>
    </div>

    <h5>📒 Mes dernières opérations</h5>
    var ops = ViewBag.MesOperations as List<AkarangaBank.Web.Models.Operation> ?? new List<AkarangaBank.Web.Models.Operation>();
    if (!ops.Any())
    {
        <p class="text-muted">Aucune opération récente.</p>
    }
    else
    {
        <table class="table bg-white">
            <thead class="table-light">
                <tr><th>Date</th><th>Type</th><th>Compte</th><th class="text-end">Montant</th></tr>
            </thead>
            <tbody>
            @foreach (var o in ops)
            {
                <tr>
                    <td>@o.DateOperation.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@o.TypeOperation</td>
                    <td>@o.Compte.NumeroCompte</td>
                    <td class="text-end">@o.Montant.ToString("N0") BIF</td>
                </tr>
            }
            </tbody>
        </table>
    }
}