@model AkarangaBank.Web.ViewModels.ClientDetailsVM
@{ ViewData["Title"] = "Supprimer client"; }

<h2>Supprimer le client</h2>
<div class="alert alert-warning">
    Confirmez-vous la suppression de <strong>@Model.Client.Nom @Model.Client.Prenom</strong> ?
</div>

@if (Model.Comptes.Any())
{
    <div class="alert alert-danger">
        Ce client possède @Model.Comptes.Count() compte(s). La suppression sera refusée.
    </div>
}

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Client.Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>