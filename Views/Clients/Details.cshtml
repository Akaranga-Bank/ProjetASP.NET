@model AkarangaBank.Web.ViewModels.ClientDetailsVM
@{ ViewData["Title"] = "Client"; }

<h2>👤 @Model.Client.Nom @Model.Client.Prenom</h2>

<div class="row">
    <div class="col-md-6">
        <div class="bg-white p-3 rounded shadow-sm">
            <h5>Informations</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">N° client</dt><dd class="col-sm-8">@Model.Client.NumeroClient</dd>
                <dt class="col-sm-4">CNI</dt><dd class="col-sm-8">@Model.Client.NumeroCNI</dd>
                <dt class="col-sm-4">Naissance</dt><dd class="col-sm-8">@Model.Client.DateNaissance.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-4">Téléphone</dt><dd class="col-sm-8">@Model.Client.Telephone</dd>
                <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Client.Email</dd>
                <dt class="col-sm-4">Agence</dt><dd class="col-sm-8">@Model.Client.Agence.Code</dd>
                <dt class="col-sm-4">Statut</dt>
                <dd class="col-sm-8">
                    <span class="badge @(Model.Client.Statut == "Actif" ? "bg-success" : "bg-warning text-dark")">
                        @Model.Client.Statut
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="col-md-6">
        <div class="bg-white p-3 rounded shadow-sm">
            <h5>Comptes (@Model.Comptes.Count())</h5>
            @if (!Model.Comptes.Any())
            {
                <p class="text-muted">Aucun compte.</p>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th>Numéro</th><th>Type</th><th class="text-end">Solde</th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.Comptes)
                    {
                        <tr>
                            <td>@c.NumeroCompte</td>
                            <td>@c.TypeCompte.Libelle</td>
                            <td class="text-end">@c.Solde.ToString("N0") @c.Devise</td>
                        </tr>
                    }
                    </tbody>
                </table>
                <p class="text-end mt-2 mb-0"><strong>Solde total : @Model.SoldeTotal.ToString("N0") BIF</strong></p>
            }
        </div>
    </div>
</div>

<div class="mt-3 bg-white p-3 rounded shadow-sm">

    @if (User.IsInRole("admin") || User.IsInRole("gestionnaire"))
{
    <form asp-action="AjouterKYC" method="post" class="mb-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="clientId" value="@Model.Client.Id" />
        <button class="btn btn-sm btn-info">+ Ajouter un KYC</button>
    </form>
}


    <h5>Vérifications KYC</h5>
    @if (!Model.Verifications.Any())
    {
        <p class="text-muted">Aucune vérification KYC enregistrée.</p>
    }
    else
    {
        <table class="table table-sm mb-0">
            <thead><tr><th>Type</th><th>N° doc</th><th>Statut</th><th>Date</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var k in Model.Verifications)
            {
                <tr>
                    <td>@k.TypeDocument</td>
                    <td>@k.NumeroDocument</td>
                    <td>
                        <span class="badge @(k.Statut == "Valide" ? "bg-success" : k.Statut == "Rejete" ? "bg-danger" : "bg-warning text-dark")">
                            @k.Statut
                        </span>
                    </td>
                    <td>@(k.DateVerification?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        @if (k.Statut == "EnAttente" && (User.IsInRole("admin") || User.IsInRole("gestionnaire")))
                        {
                            <form asp-action="ValiderKYC" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@k.Id" />
                                <button class="btn btn-sm btn-success">Valider</button>
                            </form>
                            <form asp-action="RejeterKYC" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@k.Id" />
                                <input type="hidden" name="commentaire" value="Rejeté" />
                                <button class="btn btn-sm btn-danger">Rejeter</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="mt-3">
    <a asp-controller="Comptes" asp-action="Create" asp-route-clientId="@Model.Client.Id" class="btn btn-success">+ Ouvrir un compte</a>
    <a asp-action="Edit" asp-route-id="@Model.Client.Id" class="btn btn-warning">Modifier</a>
    <a asp-action="Index" class="btn btn-secondary">← Retour</a>
</div>