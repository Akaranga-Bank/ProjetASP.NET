@model AkarangaBank.Web.ViewModels.RetraitVM
@{ ViewData["Title"] = "Retrait"; }

<h2>💰 Nouveau retrait</h2>

<form asp-action="Retrait" method="post" class="bg-white p-4 rounded shadow-sm" style="max-width:600px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CompteId" class="form-label"></label>
        <select asp-for="CompteId" asp-items="ViewBag.Comptes" class="form-select">
            <option value="">-- Sélectionner un compte --</option>
        </select>
        <span asp-validation-for="CompteId" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Montant" class="form-label">Montant (BIF)</label>
        <input asp-for="Montant" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Montant" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Commentaire" class="form-label"></label>
        <textarea asp-for="Commentaire" class="form-control" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer le retrait</button>
    <a asp-action="Journal" class="btn btn-secondary">Annuler</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }