@model AkarangaBank.Web.Models.Agence
@{ ViewData["Title"] = "Supprimer agence"; }

<h2>Supprimer l'agence</h2>
<div class="alert alert-warning">Confirmez-vous la suppression de <strong>@Model.Nom</strong> ?</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>